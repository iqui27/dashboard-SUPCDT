{
  "name": "dashboard-supcdt",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "dev:e2e": "node scripts/run-with-e2e-env.js npm run dev",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "preview": "npx vite preview",
    "server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node dist-server/index.js",
    "start": "npm run start:server",
    "heroku-postbuild": "npm run build",
    "e2e:mongo:up": "docker compose -f docker-compose.e2e.yml up -d mongo",
    "e2e:mongo:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:mongo:logs": "docker compose -f docker-compose.e2e.yml logs -f mongo",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "test:smoke:public": "playwright test --config=playwright.config.ts --grep @public",
    "test:smoke:auth": "node scripts/run-auth-smoke.js",
    "test:smoke:auth:local": "node scripts/run-local-auth-smoke.js",
    "test:smoke:auth:local:headed": "node scripts/run-local-auth-smoke.js --headed",
    "test:smoke:auth:headed": "node scripts/run-auth-smoke.js --headed",
    "test:smoke:headed": "playwright test --config=playwright.config.ts --headed",
    "test:functional:local": "node scripts/run-local-functional-qa.js",
    "test:functional:local:headed": "node scripts/run-local-functional-qa.js --headed"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.0",
    "@react-email/render": "^2.0.0",
    "@types/json2csv": "^5.0.7",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "latest",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.34.3",
    "googleapis": "^129.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.522.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-email": "^5.0.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "resend": "^3.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "latest",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.18",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^9.2.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vite": "^5.2.0"
  }
}
